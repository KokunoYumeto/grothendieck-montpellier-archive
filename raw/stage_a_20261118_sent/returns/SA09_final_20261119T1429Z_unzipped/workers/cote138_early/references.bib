@article{LMS2014,
  author = {Lenstra, Hendrik W., Jr. and Moree, Pieter and Stevenhagen, Peter},
  title = {Character sums for primitive root densities},
  journal = {Mathematical Proceedings of the Cambridge Philosophical Society},
  volume = {157},
  pages = {489--511},
  year = {2014},
  doi = {10.1017/S0305004114000450},
  url = {https://arxiv.org/abs/1112.4816},
  eprint = {1112.4816},
  archivePrefix = {arXiv},
  note = {verified},
  annote = {Abstract/history and full https://arxiv.org/pdf/1112.4816 opened. First circulation 20 December 2011; version 4 dated 25 August 2014; journal online 5 November 2014. §2 Lemma 2.5, Theorem 2.9 and Remark 2.12(2) read. Theorem 2.9 identifies the arithmetic radical image as the kernel of the product of two quadratic characters, of index two in the ambient affine automorphism group. For r0=2 it gives (-1)^b=(2/a). The paragraph following Lemma 2.5 distinguishes the split ambient group from the nonsplit arithmetic extension. These algebraic statements do not require GRH. Backward references followed to Schinzel 1977.}
}

