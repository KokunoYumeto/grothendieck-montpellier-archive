    "C-SA13-064": {
      "statement": "Let R⊂Rbar be same-dimensional noetherian regular local domains with Rbar centered on m, mRbar=mbar, and the same residue field. Then R/m^q→Rbar/mbar^q is an isomorphism for every q and the completions agree. For every ideal J of R, JRbar∩R=J, J is principal iff JRbar is principal, and Frac(R)∩Rbar=R in the common fraction overfield.",
      "items": [
        "SA13-184",
        "SA13-185"
      ],
      "remove_inaccurate_restriction": "The bar on Rbar does not require Rbar to be the completion of R; that is only a special case.",
      "exact_continuation": "p2scan173global744–748→p1scan137global957–983→p1scan135global908–910"
    },
    "C-SA13-072": {
