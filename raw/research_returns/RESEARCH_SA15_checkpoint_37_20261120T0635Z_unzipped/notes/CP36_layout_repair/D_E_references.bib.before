@misc{Jiang2023Derived,
 author={Jiang, Andy},
 title={The Derived Ring of Differential Operators},
 year={2023},
 eprint={2303.16083},
 archivePrefix={arXiv},
 primaryClass={math.AG},
 url={https://arxiv.org/pdf/2303.16083},
 note={Opened and downloaded original arXiv v1, dated 28 March 2023, on 19 November 2026. Read Theorem 2.1 with proof and Remark 2.4, pp.16--17; Proposition 6.2, Theorem 6.3 and their complete proofs, pp.32--34; Appendix B, Definitions B.1--B.3 and Theorem B.5 with proof, pp.43--45. This is a derived comparison. The report supplies separate nilpotent-filtration arguments for ordinary flat coefficients and for the H0 of coherent derived crystals, together with completed ordinary full faithfulness. Root and monodromy independently read these exact source locators before the ordinary coherent theorem was promoted. The related Michigan dissertation could not be fetched (403), and is not cited as read.}
}

