@misc{AuditGrothendieckEGAVOriginal,
 author={Grothendieck, Alexander},
 title={EGA V prenotes: original French typescript with manuscript corrections},
 url={https://webusers.imj-prg.fr/~leila.schneps/grothendieckcircle/EGA/EGA5.pdf},
 note={Opened targeted leaves of the complete 171-page original scan downloaded, 16,097,021 bytes. Original scan and handwritten page89, Proposition14.5 and Corollary14.6, visually inspected at180dpi on19November2026, together with p88. Corollary14.6 explicitly gives a birational morphism onto a hypersurface in projective (n+1)-space; the following paragraph records that it need not be an immersion. The preceding p88 leaves the indicated differential-property proofs to Dieudonne. F.3.14 supplies an independent characteristic-zero proof including finiteness, normalization, and the nodal cohomology comparison. No date or execution of the separate cote14 standard-conjecture proposal is inferred}
}
