 year={1969},
 url={https://csg.igrothendieck.org/wp-content/uploads/2024/10/L3u.pdf},
 note={Original twenty-seven-page typescript opened 19 November 2026. Sections 1--3, printed pp.1--8, and sections 5.3--5.8 and 6, printed pp.19--26, inspected for the chronology search. Section 6 studies deformations across nilimmersions. No Galois reconstruction theorem is imported from the inspected passages; the date is independently catalogued by CSG. This search does not claim full mathematical verification of the letter}
}
