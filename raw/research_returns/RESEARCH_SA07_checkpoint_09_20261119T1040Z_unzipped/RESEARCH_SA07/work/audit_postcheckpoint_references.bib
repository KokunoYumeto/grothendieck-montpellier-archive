@misc{AuditStacksFiniteNormalization,
 author={{The Stacks Project Authors}},
 title={Finite proper morphisms and normalization},
 url={https://stacks.math.columbia.edu/tag/02LS},
 note={Opened and proofs read 19 November 2026: Tag 02LS, Lemma 37.44.1, proper plus locally quasi-finite is equivalent to finite; Tag 0AB1, Lemma 29.55.8, https://stacks.math.columbia.edu/tag/0AB1, finite birational over a normal integral target is an isomorphism. F.3.14 additionally gives the direct coordinate-ring proof identifying its smooth source as the normalization}
}
@misc{AuditCote15Original,
