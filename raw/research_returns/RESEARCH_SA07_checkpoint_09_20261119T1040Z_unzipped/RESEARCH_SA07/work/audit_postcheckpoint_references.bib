@misc{AuditGrothendieckTate1966,
 author={Grothendieck, Alexander},
 title={Letter to John Tate, May 1966: crystals and formal groups},
 year={1966},
 url={https://csg.igrothendieck.org/wp-content/uploads/2024/10/L9u.pdf},
 note={Complete original thirty-page typescript downloaded and opened 19 November 2026. First leaf's handwritten date and final numbered p.30, section 3.2, visually verified. The final paragraph asks for the generic-fibre Tate module from the lifted filtration and Dieudonne data, initially with the ordinary-type reduction qualification of section 3.1; the following sentence asks about more general p-divisible groups. Sections 2.4--2.8 and 3.1--3.2 were read for scope. CSG identifies the letter as unpublished; the official Montpellier inventory independently identifies cote 6 as Lettre Tate (mai 66). This source does not itself date leaf 18:5}
}
@incollection{AuditGrothendieckCrystals1968,
 author={Grothendieck, Alexander},
 title={Crystals and the de Rham cohomology of schemes},
 booktitle={Dix exposes sur la cohomologie des schemas},
 series={Advanced Studies in Pure Mathematics}, volume={3},
 publisher={North-Holland and Masson}, year={1968}, pages={306--358},
 url={https://download.uni-mainz.de/mathematik/Algebraische%20Geometrie/Lehre/WS23.Padische.1966.Grothendieck.CRCSscan.pdf},
 note={Original complete 53-page text downloaded and opened. Notes by J. Coates and O. Jussila of November--December 1966 talks, as stated on p.306. Sections 1.5--1.6 pp.311--317 and 7.1--7.5 pp.351--356 checked, especially section 7.2 pp.352--353's comparison of crystalline cohomology with de Rham cohomology of a smooth proper Witt-vector lift. The inspected passage does not assert reconstruction of the Galois representation}
}
@misc{AuditCSGCorrespondenceCatalogue,
 author={{Centre for Grothendieckian Studies}},
 title={Alexander Grothendieck: correspondence catalogue},
 url={https://csg.igrothendieck.org/correspondence/},
