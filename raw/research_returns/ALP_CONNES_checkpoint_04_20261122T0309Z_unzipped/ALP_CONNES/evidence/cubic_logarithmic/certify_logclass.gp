default(realprecision,100);
default(parisizemax,1000000000);
print("PARI_VERSION=",version());
c=polcompositum(x^3-269,x^2+x+1,1)[1];
print("COMPOSITUM=",c);
b=bnfinit(c[1],1);
print("POLYNOMIAL=",b.pol);
print("DISCRIMINANT=",b.disc);
print("CLASSGROUP=",b.cyc);
print("CLASSNUMBER=",b.no);
print("CERTIFY=",bnfcertify(b));
print("LOGCLASS_3=",bnflog(b,3));
print("FUNDAMENTAL_UNITS=",b.fu);
s=idealprimedec(b,3);
print("PRIMES_3=",s);
u=bnfsunit(b,s);
print("SUNITS=",u);
writebin("ALP_CONNES/evidence/cubic_logarithmic/cubic_bnf.bin",b);
