@article{cyElZein1978,
 author={El Zein, Fouad},
 title={Complexe dualisant et applications \`a la classe fondamentale d'un cycle},
 journal={M\'emoires de la Soci\'et\'e Math\'ematique de France},
 volume={58}, pages={1--66}, year={1978}, doi={10.24033/msmf.242},
 url={https://www.numdam.org/item/MSMF_1978__58__1_0.pdf},
 note={OPENED full 67-page primary scan. Section 2.4, printed pp.~31--32, defines proper trace in Hodge homology and its duality description. Section 3.1, pp.~34--41, constructs the normalized fundamental class; Proposition 2 on p.~41 states the proper dominant pushforward formula. The local first-conormal specialization needed in C.3au is proved separately in the text.}
}
