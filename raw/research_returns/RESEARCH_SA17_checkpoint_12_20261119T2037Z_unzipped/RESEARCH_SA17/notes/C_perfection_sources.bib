@article{C-BayerLenstraOddDegree1990,
 author={Bayer-Fluckiger, Eva and Lenstra, Hendrik W., Jr.},
 title={Forms in Odd Degree Extensions and Self-Dual Normal Bases},
 journal={American Journal of Mathematics},
 volume={112}, number={3}, pages={359--373}, year={1990},
 doi={10.2307/2374746},
 url={https://pub.math.leidenuniv.nl/~lenstrahw/PUBLICATIONS/1990e/art.pdf},
 note={Primary author-hosted PDF opened 2026-11-19.
 Proposition1.2 and Corollary1.4, with their complete proofs,
 printed pp362--363, establish odd-degree Witt injectivity and
 actual hermitian isometry reflection for a finite-dimensional
 division algebra with base-linear involution, for either sign.
 The extension is not assumed separable. The proof uses a nonzero
 linear functional, rather than the possibly zero field trace.}
}
