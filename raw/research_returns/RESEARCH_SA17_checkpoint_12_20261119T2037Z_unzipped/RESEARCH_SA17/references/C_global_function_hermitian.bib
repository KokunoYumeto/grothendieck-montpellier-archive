@misc{C-LewisUngerVanGeel2004,
 author={Lewis, David W. and Unger, Thomas and Van Geel, Jan},
 title={The Hasse principle for similarity of hermitian forms},
 year={2004},
 url={https://www.math.uni-bielefeld.de/lag/man/130.pdf},
 note={Author preprint dated30January2004, primary full text opened and read2026-11-19. Exact inputs: introduction pp1--2 quadratic Hasse principles; Theorem2.4(i) pp6--7 local quaternion skew classification; Theorem2.7(ii)p7 global representation for rank at least2; Section3, Theorem3.1 and Corollary3.2 pp18--19 unitary isometry by rank, reduced-norm determinant and real signatures. The scope explicitly includes odd-characteristic global function fields. The manuscript does not use the paper's rank-one discriminant list or a false skew-hermitian Hasse isometry principle.}
}
