@article{Hatcher1983,
 author={Hatcher, Allen E.},
 title={A proof of the {Smale} conjecture, {Diff}({S}$^3$) $\simeq$ {O}(4)},
 journal={Annals of Mathematics}, series={2}, volume={117}, number={3},
 pages={553--607}, year={1983}, doi={10.2307/2007035},
 url={https://pi.math.cornell.edu/~hatcher/Papers/SmaleConjecture.pdf},
 note={OPENED: complete original author-hosted PDF downloaded, 14720341 bytes. Appendix statement (3), printed p.605, explicitly includes TOP in the comparison for 3-manifolds; statement (16), printed p.606, explicitly gives TOP(S3) homotopy equivalent to O(4). Both original pages rendered and visually inspected by singularities-duality and root, 2026-11-19. This supports the actual compact-open TOP group, not merely the smooth theorem.}
}

