\NeedsTeXFormat{LaTeX2e}[95/06/01]
\ProvidesPackage{mytheorems2}
                [2005/06/14 David's EGA-like Theorem Styles, version 1.0]

\def\mytheorembase{subsection}
\def\thmcounter{theorem}
\DeclareOption{nosubsections}{\def\mytheorembase{section}}
\DeclareOption{flatsubsections}{%
\def\mytheorembase{}%
\def\thmcounter{subsection}%
}
\ExecuteOptions{}
\ProcessOptions\relax

\RequirePackage{amsthm}

%\swapnumbers

%\newtheoremstyle{note}% name
%  {3pt}%                Space above (can use \topsep for default)
%  {3pt}%                Space below (can use \topsep for default)
%  {}%                   Body font
%  {}%                   Indent amount (empty = no indent, \parindent = para indent)
%  {\itshape}%           Thm head font
%  {:}%                  Punctuation after thm head
%  {.5em}%               Space after thm head: " " = normal interword space;
%                        \newline = linebreak
%  {}%                   Thm head spec (can be left empty, meaning 'normal')

\newtheoremstyle{dtheorem}{3 mm}{1 mm}{\itshape}{}{\bfseries}{.}{ }
{\thmname{#1}\thmnumber{\@ifnotempty{#1}{~}(#2)}%
\thmnote{ \mdseries(#3)\bfseries}}
\newtheoremstyle{ddef}{3 mm}{1 mm}{\normalfont}{}{\bfseries}{.}{ }
{\thmname{#1}\thmnumber{\@ifnotempty{#1}{~}(#2)}%
\thmnote{ \mdseries(#3)\bfseries}}
\newtheoremstyle{dremark}{3 mm}{1 mm}{\normalfont}{}{\itshape}{}{ }
{\thmname{#1}%
\thmnumber{\@ifnotempty{#1}{~}\upshape\bfseries(#2).\itshape\mdseries}%
\thmnote{\;\mdseries #3 ---}}
% Or should remark's be without a dot? Perhaps makes []-comment look strange?

\newtheoremstyle{dxpar}{3 mm}{1 mm}{\normalfont}{}{\bfseries}{}{ }
{\thmname{#1}\thmnumber{\@ifnotempty{#1}{~}(#2)}%
\thmnote{\;\itshape\mdseries #3 ---}}


\theoremstyle{dtheorem}

\ifx\mytheorembase\@empty%
   \newtheorem{theorem}[\thmcounter]{Theorem}
\else
   \newtheorem{theorem}{Theorem}[\mytheorembase]
\fi

\newtheorem*{theorem*}{Theorem}
\newtheorem{axiom}[\thmcounter]{Axiom}
\newtheorem{corollary}[\thmcounter]{Corollary}
\newtheorem*{corollary*}{Corollary}
\newtheorem{lemma}[\thmcounter]{Lemma}
\newtheorem{proposition}[\thmcounter]{Proposition}
\newtheorem{definition-proposition}[\thmcounter]{Definition-Proposition}
\newtheorem{proposition-definition}[\thmcounter]{Proposition-Definition}
\newtheorem{conjecture}[\thmcounter]{Conjecture}
\newtheorem{main_lemma}[\thmcounter]{Main Lemma}
\newtheorem{formula}[\thmcounter]{Formula}
\theoremstyle{ddef}
\newtheorem{definition}[\thmcounter]{Definition}
\newtheorem{notation}[\thmcounter]{Notation}
\newtheorem*{notation*}{Notation}
\newtheorem{setup}[\thmcounter]{Setup}
\newtheorem{convention}[\thmcounter]{Convention}
\newtheorem{properties}[\thmcounter]{Properties}
\newtheorem{example}[\thmcounter]{Example}
\newtheorem{examples}[\thmcounter]{Examples}
\theoremstyle{dremark}
\newtheorem{note}[\thmcounter]{Note}
\newtheorem{problem}[\thmcounter]{Problem}
\newtheorem{question}[\thmcounter]{Question}
\newtheorem{questions}[\thmcounter]{Questions}
\newtheorem{correction}[\thmcounter]{Correction}
\newtheorem{suggestion}[\thmcounter]{Suggestion}
\newtheorem{remark}[\thmcounter]{Remark}
\newtheorem{warning}[\thmcounter]{Warning}
\newtheorem{solution}[\thmcounter]{Solution}
\newtheorem{acknowledgement}[\thmcounter]{Acknowledgement}
\theoremstyle{dxpar}
\newtheorem{xpar}[\thmcounter]{}
%\newtheorem{xexample}[\thmcounter]{Example}

% This is perhaps a better solution!
%\newenvironment{proof*}[1][\proofname]{\proof\renewcommand{\qedsymbol}{}}{\endproof}

\newenvironment{proof*}[1][\proofname]{\par
  \normalfont \vspace{-2 mm} \topsep6\p@\@plus6\p@\relax
  \trivlist
  \item[\hskip\labelsep
        \itshape
    #1\@addpunct{.}]\ignorespaces
}{%
  \endtrivlist\@endpefalse
}

\renewenvironment{proof}[1][\proofname]{\par
  \pushQED{\qed}%
  \normalfont \vspace{-2 mm} \topsep6\p@\@plus6\p@\relax
  \trivlist
  \item[\hskip\labelsep
        \itshape
    #1\@addpunct{.}]\ignorespaces
}{%
  \popQED\endtrivlist\@endpefalse
}

\newenvironment{construction}[1][Construction]{\par
  \normalfont \vspace{-2 mm} \topsep6\p@\@plus6\p@\relax
  \trivlist
  \item[\hskip\labelsep
        \itshape
    #1\@addpunct{.}]\ignorespaces
}{\endtrivlist\@endpefalse
}


\numberwithin{equation}{\thmcounter}

\endinput
