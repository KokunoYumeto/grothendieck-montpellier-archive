default(realprecision,100);
default(parisizemax,2147483648);
v=read("ALP_CONNES/evidence/cubic_logarithmic/layer1_classfields.bin");b=v[1];pp=v[3];s=idealprimedec(b,3);rr=vector(4,j,-polcoef(pp[j],0));
print("LOCAL_CUBE_TESTS=",matrix(4,3,i,j,nfislocalpower(b,s[j],rr[i],3)));
print("LOGARITHMIC_INDICES=",vector(3,j,bnflogef(b,s[j])));
u=bnfsunit(b,s);uv=concat(b.fu,u[1]);
print("SUNIT_COUNT=",#uv);
ff=vector(#uv,j,idealfactor(b,uv[j]));
print("SUNIT_SUPPORT_VERIFIED=",vector(#uv,j,prod(k=1,matsize(ff[j])[1],ff[j][k,1][1]==3)));
print("SUNIT_IDEAL_FACTORIZATIONS=",ff);
fp=factorpadic(b.pol,3,60)[,1];
print("LOCAL_FACTOR_DEGREES=",vector(#fp,j,poldegree(fp[j])));
deg=3*log(4+O(3^60));
M=matrix(3,#uv,i,j,-log(polresultant(fp[i],lift(nfbasistoalg(b,uv[j]))))/deg);
print("LOG_MATRIX_MIN_PRECISION=",padicprec(M,3));
print("LOG_MATRIX_MOD81=",lift(Mod(M,81)));
print("LOG_COLUMN_SUM_VALUATIONS=",vector(#uv,j,valuation(sum(i=1,3,M[i,j]),3)));
found=0;for(i=1,#uv,for(j=i+1,#uv,dd=M[1,i]*M[2,j]-M[1,j]*M[2,i];if(valuation(dd,3)<=2,print("MINOR_CERTIFICATE=",[i,j,valuation(dd,3),padicprec(dd,3),lift(Mod(dd,81))]);si=i;sj=j;found=1;break));if(found,break));
print("SELECTED_SUNITS=",[uv[si],uv[sj]]);
writebin("ALP_CONNES/evidence/cubic_logarithmic/layer1_logkernel_certificate.bin",[s,uv,fp,M,si,sj]);
