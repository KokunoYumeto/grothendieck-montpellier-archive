default(parisize,500000000);
default(realprecision,100);
v=read("ALP_CONNES/evidence/cubic_logarithmic/real_cubic_field_action.bin");b=v[1];ga=v[4];ss=v[5];n=2;ns=#ss;prec=80;
shifts=vector(n,i,idealcoprime(b,b.gen[i],3));
gens=vector(n,i,idealmul(b,b.gen[i],shifts[i]));
print("GENERATOR_SHIFTS=",shifts);print("COPRIME_GENERATORS=",gens);
print("COPRIME3=",matrix(ns,n,j,i,idealval(b,gens[i],ss[j])));
convpr(I)={my(v=bnfisprincipal(b,I,1));[v[1],nfbasistoalg(b,v[2])/prod(i=1,n,nfbasistoalg(b,shifts[i])^v[1][i])]};
fp0=factorpadic(b.pol,3,prec)[,1];
fp=vector(ns,j,select(t->poldegree(t)==ss[j].e*ss[j].f,fp0)[1]);
deg=3*log(4+O(3^prec));
vl(a)=vector(ns,j,-log(polresultant(fp[j],lift(nfbasistoalg(b,a))))/deg)~;
rr=vector(n,i,log(idealnorm(b,gens[i])+O(3^prec))/deg);
print("LOCAL_DEGREES=",vector(ns,j,poldegree(fp[j])));print("GENERATOR_DEGREES_MOD27=",lift(Mod(rr,27)));
powrels=vector(n,i,convpr(idealpow(b,gens[i],b.cyc[i])));
prrels=vector(ns,j,convpr(ss[j]));
allrels=concat(concat(vector(n,i,powrels[i][2]),vector(ns,j,prrels[j][2])),b.fu);
M=matrix(n+ns,#allrels,i,j,if(i>n,vl(allrels[j])[i-n],if(j<=n,if(i==j,b.cyc[i],0),if(j<=n+ns,-prrels[j-n][1][i],0))));
print("POWERS_PRINCIPAL=",vector(n,i,powrels[i][1]==vector(n,j,0)~));
print("POWER_IDEAL_EQUALITIES=",vector(n,i,idealhnf(b,powrels[i][2])==idealpow(b,gens[i],b.cyc[i])));
print("PRIME_IDEAL_EQUALITIES=",vector(ns,j,idealmul(b,prrels[j][2],idealfactorback(b,gens,prrels[j][1]))==idealhnf(b,ss[j])));
print("RELATION_DEGREE_VALUATIONS=",vector(#allrels,j,valuation(sum(i=1,n,rr[i]*M[i,j])+sum(i=n+1,n+ns,M[i,j]),3)));
M0=M[1..n+ns-1,];
print("RELATION_PRECISION=",padicprec(M0,3));print("RELATION_MOD27=",lift(Mod(M0,27)));
gamrels=vector(n,i,convpr(nfgaloisapply(b,ga,gens[i])));
GG=matrix(n+ns,n+ns,i,j,if(j<=n,if(i<=n,gamrels[j][1][i],-vl(gamrels[j][2])[i-n]),if(i>n,idealval(b,nfgaloisapply(b,ga,ss[j-n]),ss[i-n]),0)));
print("GAMMA_IDEAL_EQUALITIES=",vector(n,j,idealmul(b,gamrels[j][2],idealfactorback(b,gens,gamrels[j][1]))==nfgaloisapply(b,ga,gens[j])));
K=matrix(n+ns,n+ns-1,i,j,if(i<n+ns,if(i==j,1,0),if(j<=n,-rr[j],-1)));
G0=(GG*K)[1..n+ns-1,];
print("GAMMA_PRECISION=",padicprec(G0,3));print("GAMMA_MOD27=",lift(Mod(G0,27)));
MM=lift(Mod(M0,9));GM=lift(Mod(G0,9));qq=[0,1,6];
print("CYCLIC_QUOTIENT_ROW=",qq);
print("QUOTIENT_RELATIONS_MOD9=",lift(Mod(qq*MM,9)));
print("GAMMA_SCALAR4_CHECK=",lift(Mod(qq*GM-4*qq,9))==[0,0,0]);
HH=mathnf(concat(lift(Mod(M0,27)),27*matid(n+ns-1)));
print("RELATION_SMITH_MOD27=",matsnf(HH));
if(padicprec(M0,3)<10 || padicprec(G0,3)<10,quit(1));
if(lift(Mod(qq*MM,9))!=vector(matsize(MM)[2],j,0),quit(1));
if(lift(Mod(qq*GM-4*qq,9))!=[0,0,0],quit(1));
if(matsnf(HH)!=[9,1,1],quit(1));
print("CERTIFICATE_PASS=1");
writebin("ALP_CONNES/evidence/cubic_logarithmic/real_cubic_logarithmic_gamma.bin",[b,ga,ss,gens,shifts,fp,rr,M,M0,gamrels,GG,G0,powrels,prrels]);
quit
