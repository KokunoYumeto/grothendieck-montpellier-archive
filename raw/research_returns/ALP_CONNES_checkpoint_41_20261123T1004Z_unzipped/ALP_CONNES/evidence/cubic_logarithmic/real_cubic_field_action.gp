default(parisize,500000000);
default(realprecision,100);
b=read("ALP_CONNES/evidence/cubic_logarithmic/real_cubic_layer1_preliminary.bin");
print("IRREDUCIBLE=",polisirreducible(b.pol));
print("MAX_ORDER=",nfcertify(b));
aa=nfroots(b,x^3-269)[1];bb=nfroots(b,x^3-3*x+1)[1];
print("ALPHA=",aa);print("BETA=",bb);
print("ALPHA_EQUATION=",aa^3==269);print("BETA_EQUATION=",bb^3-3*bb+1==0);
aut=nfgaloisconj(b);
print("AUTOMORPHISMS=",aut);
for(j=1,#aut,if(nfgaloisapply(b,aut[j],bb)==2-bb-bb^2,ga=aut[j];print("NORMALIZED_GAMMA=",ga)));
print("GAMMA_FIXES_ALPHA=",nfgaloisapply(b,ga,aa)==aa);
s=idealprimedec(b,3);
print("PRIMES3=",s);print("LOG_INDICES=",vector(#s,j,bnflogef(b,s[j])));
print("CLASS_GENERATORS=",b.gen);
print("GAMMA_CLASS_COORDS=",vector(#b.gen,j,bnfisprincipal(b,nfgaloisapply(b,ga,b.gen[j]),1)));
writebin("ALP_CONNES/evidence/cubic_logarithmic/real_cubic_field_action.bin",[b,aa,bb,ga,s]);
quit
